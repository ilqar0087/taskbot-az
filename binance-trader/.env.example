# Safe defaults: public market scanner only, Binance TESTNET only
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
TRADING_MODE=testnet
AUTO_TRADE_TESTNET=false
RISK_EQUITY_USD=0
BINANCE_API_KEY=
BINANCE_API_SECRET=
SCAN_INTERVAL_SECONDS=300
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT
SPOT_ENABLED=true
FUTURES_ENABLED=true
MAX_LEVERAGE=10
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=2.0
MAX_DRAWDOWN_PCT=5.0
DATABASE_PATH=/data/trader.sqlite3
